# Agent %i: one ADK agent, started by its socket (Custos
# CONTRACT.md §5). Per-agent changes go into
# /etc/systemd/system/agent@%i.service.d/ (Cockpit writes 50-cockpit.conf).
[Unit]
Description=Agent %i
Documentation=https://github.com/sdrahn/custos/blob/main/CONTRACT.md
Requires=agent@%i.socket
After=agent@%i.socket network-online.target mcp-gateway.service
Wants=network-online.target
ConditionPathExists=/etc/custos/agents/%i/agent.yaml

[Service]
Type=exec
ExecStart=/usr/libexec/custos/agent-launcher serve
User=agent-%i
Group=agent-%i
SupplementaryGroups=mcp-users
ConfigurationDirectory=custos/agents/%i
# As agent-admin creates it (root:agent-%i 0750).
ConfigurationDirectoryMode=0750
StateDirectory=agents/%i
StateDirectoryMode=0700
ImportCredential=agent-%i.*
# systemd decrypts the credentials before the agent starts, already under
# the device policy of PrivateDevices= below. On a host with a TPM2,
# systemd-creds encrypt (agent-admin set-credential) seals them to the TPM
# too, so that decryption needs it. The agent's own /dev stays private.
DeviceAllow=/dev/tpmrm0 rw
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s

# Sandbox (CONTRACT.md §5). Drop-ins may loosen it; Cockpit marks them.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The network: the gateway (a Unix socket) and the model endpoint, nothing
# else (CONTRACT.md §3a). Every address but the host's own is denied; each
# start, agent-admin fence adds the model endpoint's addresses and the
# nameservers, as root ("+"), for that start. Should it fail ("-"), the
# denial stands. More: a drop-in with IPAddressAllow=.
IPAddressDeny=any
IPAddressAllow=localhost
ExecStartPre=+-/usr/sbin/agent-admin fence %i
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Not the gateway's control socket, not the other agents' sockets:
# delegation goes through the gateway (§9). SELinux enforces both too.
InaccessiblePaths=-/run/mcp-gateway/control.sock
# The agent gets its own socket from systemd as a file descriptor.
TemporaryFileSystem=/run/agents:ro
