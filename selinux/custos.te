policy_module(custos, 1.0.0)

# Custos agents (CONTRACT.md §13). Each agent's launcher runs in
# agent_t. It may reach mcp-gateway's MCP socket, its model endpoint over
# HTTP(S), journald and its own files. It may never reach the gateway's
# control socket or another agent's socket: delegation goes through the
# gateway, whose agents server runs in mcpsrv_agents_t.
#
# Not yet built against SLES 16 / Leap 16 policy: see
# packaging/suse/README.md, "Before the first release".

gen_require(`
	type unconfined_t;
	type init_t;
	type init_var_run_t;
')

type agent_t;
type agent_exec_t;
init_daemon_domain(agent_t, agent_exec_t)

type agent_conf_t;
files_config_file(agent_conf_t)

type agent_var_lib_t;
files_type(agent_var_lib_t)

type agent_runtime_t;
files_pid_file(agent_runtime_t)

type agent_sock_t;
files_type(agent_sock_t)

## <desc><p>Allow agents to connect to any TCP port (model servers on unusual ports).</p></desc>
gen_tunable(agent_connect_any, false)

# Own files.
read_files_pattern(agent_t, agent_conf_t, agent_conf_t)
list_dirs_pattern(agent_t, agent_conf_t, agent_conf_t)
manage_files_pattern(agent_t, agent_var_lib_t, agent_var_lib_t)
manage_dirs_pattern(agent_t, agent_var_lib_t, agent_var_lib_t)
list_dirs_pattern(agent_t, agent_runtime_t, agent_runtime_t)

# The listening socket systemd passes, and serving on it.
allow agent_t agent_sock_t:sock_file getattr;
allow agent_t init_t:unix_stream_socket { accept read write getattr getopt setopt shutdown };
allow agent_t self:unix_stream_socket create_stream_socket_perms;
allow agent_t self:tcp_socket create_stream_socket_perms;
allow agent_t self:udp_socket create_socket_perms;
allow agent_t self:process { getsched signal };
allow agent_t self:fifo_file rw_fifo_file_perms;

# Go runtime and libraries (the programs link libc through cgo: NSS for
# user names, the resolver).
corecmd_search_bin(agent_t)
can_exec(agent_t, agent_exec_t)
libs_use_ld_so(agent_t)
libs_use_shared_libs(agent_t)
files_search_etc(agent_t)
files_search_var_lib(agent_t)
files_search_pids(agent_t)
kernel_read_system_state(agent_t)
kernel_read_kernel_sysctls(agent_t)
files_read_etc_files(agent_t)
files_read_usr_files(agent_t)
miscfiles_read_localization(agent_t)
miscfiles_read_generic_certs(agent_t)
sysnet_dns_name_resolve(agent_t)
auth_use_nsswitch(agent_t)
dev_read_urand(agent_t)
dev_read_sysfs(agent_t)

# Journal (native protocol) and credentials.
logging_send_syslog_msg(agent_t)
init_read_state(agent_t)
# Secrets (model.credential): systemd mounts the unit's credentials at
# $CREDENTIALS_DIRECTORY, /run/credentials/<unit>, labeled
# init_var_run_t (as mcp-gateway's policy grants its servers); those of
# other units are not in the agent's mount namespace. The base policy
# does not audit the denial: the agent only saw "permission denied".
search_dirs_pattern(agent_t, init_var_run_t, init_var_run_t)
read_files_pattern(agent_t, init_var_run_t, init_var_run_t)

# Model endpoints.
corenet_tcp_connect_http_port(agent_t)
corenet_tcp_connect_http_cache_port(agent_t)
tunable_policy(`agent_connect_any',`
	corenet_tcp_connect_all_ports(agent_t)
')

# The gateway's MCP socket. Deliberately not mcp_gateway_control_client.
mcp_gateway_client(agent_t)

# The delegation bridge: run by the gateway as the delegating agent's
# user, connects to the callee's socket (held by systemd until the
# callee starts, then by the callee).
mcp_gateway_backend_template(agents)
list_dirs_pattern(mcpsrv_agents_t, agent_runtime_t, agent_runtime_t)
read_files_pattern(mcpsrv_agents_t, agent_conf_t, agent_conf_t)
stream_connect_pattern(mcpsrv_agents_t, agent_runtime_t, agent_sock_t, init_t)
stream_connect_pattern(mcpsrv_agents_t, agent_runtime_t, agent_sock_t, agent_t)
allow mcpsrv_agents_t self:unix_stream_socket create_stream_socket_perms;

# The diagnostic commands Custos ships for mcp-gateway's exec server
# (templates/exec.d-diagnostics.yaml, installed in /etc/mcp-gateway/exec.d
# by custos-setup) run in its domain, mcpsrv_exec_t, whose shipped rules
# cover the gateway's own examples only. boot_time and boot_blame
# (systemd-analyze) ask systemd for the boot's times over D-Bus, which
# systemd checks as system status; pressure_stall reads /proc/pressure.
gen_require(`
	type mcpsrv_exec_t;
	class system status;
')
allow mcpsrv_exec_t init_t:system status;
# blame reads each unit's times, which systemd checks as status on the
# unit's file.
optional_policy(`
	gen_require(`
		attribute systemd_unit_file_type;
		class service status;
	')
	allow mcpsrv_exec_t systemd_unit_file_type:service status;
')
# Custos's server custos-net (gateway/servers.d/custos-net.yaml) runs
# mcp-server-exec in this domain with network_view: host (mcp-gateway
# 1.15): in the host's network namespace, unix and netlink sockets only.
# ip and ss read the interfaces, routes and sockets through netlink
# (route and sock_diag) and /proc/net; ip is labelled ifconfig_exec_t. The
# exec server's own instances, with a private network namespace and unix
# sockets only, cannot open a netlink socket at all.
allow mcpsrv_exec_t self:netlink_route_socket r_netlink_socket_perms;
allow mcpsrv_exec_t self:netlink_tcpdiag_socket r_netlink_socket_perms;
kernel_read_network_state(mcpsrv_exec_t)
optional_policy(`
	gen_require(`
		type ifconfig_exec_t;
	')
	can_exec(mcpsrv_exec_t, ifconfig_exec_t)
')
# time_status (timedatectl show) asks timedated over D-Bus; dbus-broker
# refuses the message without this ("A security policy denied ...").
optional_policy(`
	gen_require(`
		type systemd_timedated_t;
		class dbus send_msg;
	')
	allow mcpsrv_exec_t systemd_timedated_t:dbus send_msg;
	allow systemd_timedated_t mcpsrv_exec_t:dbus send_msg;
')
optional_policy(`
	gen_require(`
		type proc_psi_t;
	')
	list_dirs_pattern(mcpsrv_exec_t, proc_psi_t, proc_psi_t)
	read_files_pattern(mcpsrv_exec_t, proc_psi_t, proc_psi_t)
')

# Cockpit: the bridge of a logged-in user (unconfined_t) reaches the
# agents' sockets.
list_dirs_pattern(unconfined_t, agent_runtime_t, agent_runtime_t)
stream_connect_pattern(unconfined_t, agent_runtime_t, agent_sock_t, init_t)
stream_connect_pattern(unconfined_t, agent_runtime_t, agent_sock_t, agent_t)

# The relay of an agent in an OpenShell sandbox (agent-openshell@.service,
# CONTRACT.md §16a): serves the agent's socket, connects to OpenShell's
# port forward on the loopback (47000-47999, unreserved ports), runs the
# openshell CLI for the sandbox's log stream (which talks to the local
# OpenShell gateway over HTTP and reads root's OpenShell configuration),
# and writes the agent's records to the journal.
type agent_relay_t;
type agent_relay_exec_t;
init_daemon_domain(agent_relay_t, agent_relay_exec_t)

allow agent_relay_t agent_sock_t:sock_file getattr;
allow agent_relay_t init_t:unix_stream_socket { accept read write getattr getopt setopt shutdown };
allow agent_relay_t self:unix_stream_socket create_stream_socket_perms;
allow agent_relay_t self:tcp_socket create_stream_socket_perms;
allow agent_relay_t self:udp_socket create_socket_perms;
allow agent_relay_t self:process { getsched signal signull };
allow agent_relay_t self:fifo_file rw_fifo_file_perms;
list_dirs_pattern(agent_relay_t, agent_runtime_t, agent_runtime_t)
read_files_pattern(agent_relay_t, agent_conf_t, agent_conf_t)
list_dirs_pattern(agent_relay_t, agent_conf_t, agent_conf_t)
corenet_tcp_connect_unreserved_ports(agent_relay_t)
# The agents' forwarded ports (47000-47999, openshell forward) are in the
# kernel's ephemeral range, ephemeral_port_t rather than unreserved.
corenet_tcp_connect_all_ephemeral_ports(agent_relay_t)
corenet_tcp_connect_http_port(agent_relay_t)
corenet_tcp_connect_http_cache_port(agent_relay_t)
corecmd_exec_bin(agent_relay_t)
corecmd_exec_shell(agent_relay_t)
libs_use_ld_so(agent_relay_t)
libs_use_shared_libs(agent_relay_t)
files_read_etc_files(agent_relay_t)
files_read_usr_files(agent_relay_t)
files_search_pids(agent_relay_t)
kernel_read_system_state(agent_relay_t)
# /proc/net/tcp: the forward's socket must be root's before the relay
# sends its secret (security review H3).
kernel_read_network_state(agent_relay_t)
miscfiles_read_localization(agent_relay_t)
miscfiles_read_generic_certs(agent_relay_t)
auth_use_nsswitch(agent_relay_t)
sysnet_dns_name_resolve(agent_relay_t)
dev_read_urand(agent_relay_t)
logging_send_syslog_msg(agent_relay_t)
userdom_search_admin_dir(agent_relay_t)
userdom_read_admin_home_files(agent_relay_t)
# agent-openshell-logs: docker or podman logs of the sandbox's container
# (with Docker, through its socket). Podman as root under SELinux is open
# (CONTRACT.md §21, O10).
optional_policy(`
	gen_require(`
		type container_runtime_t, container_var_run_t;
	')
	stream_connect_pattern(agent_relay_t, container_var_run_t, container_var_run_t, container_runtime_t)
')
# With rootless Podman (OpenShell's RPM default) agent-openshell-logs runs
# podman as the OpenShell user (setpriv; CUSTOS_OPENSHELL_USER): podman
# runs in its own domain, also under the relay's NoNewPrivileges.
allow agent_relay_t self:capability { setuid setgid };
# setpriv keeps and then sets its capabilities across the user change
# (capset); without this it fails with no AVC record in the CI runs.
allow agent_relay_t self:process { getcap setcap };
optional_policy(`
	gen_require(`
		type container_runtime_t, container_runtime_exec_t;
		class process2 { nnp_transition nosuid_transition };
	')
	domtrans_pattern(agent_relay_t, container_runtime_exec_t, container_runtime_t)
	allow agent_relay_t container_runtime_t:process2 { nnp_transition nosuid_transition };
	allow container_runtime_t agent_relay_t:fd use;
	allow container_runtime_t agent_relay_t:fifo_file rw_fifo_file_perms;
	allow container_runtime_t agent_relay_t:process sigchld;
')
# systemd creates the agents' sockets (agent@.socket, DirectoryMode=)
# and tmpfiles /run/agents: with the right labels even before a relabel
# (the package's tmpfiles run before this module is loaded).
manage_dirs_pattern(init_t, agent_runtime_t, agent_runtime_t)
manage_sock_files_pattern(init_t, agent_runtime_t, agent_sock_t)
filetrans_pattern(init_t, agent_runtime_t, agent_sock_t, sock_file)
files_pid_filetrans(init_t, agent_runtime_t, dir, "agents")
allow init_t agent_sock_t:sock_file { relabelfrom relabelto };
allow init_t agent_runtime_t:dir { relabelfrom relabelto };
optional_policy(`
	gen_require(`
		type systemd_tmpfiles_t;
	')
	manage_dirs_pattern(systemd_tmpfiles_t, agent_runtime_t, agent_runtime_t)
	files_pid_filetrans(systemd_tmpfiles_t, agent_runtime_t, dir, "agents")
	allow systemd_tmpfiles_t { agent_runtime_t agent_var_lib_t agent_conf_t }:dir { getattr relabelfrom relabelto setattr };
')

# systemd sets up the agents' directories before starting them:
# StateDirectory= creates /var/lib/agents/<name> and hands it to the
# agent's user; ConfigurationDirectory= checks /etc/custos/...
manage_dirs_pattern(init_t, agent_var_lib_t, agent_var_lib_t)
manage_files_pattern(init_t, agent_var_lib_t, agent_var_lib_t)
files_var_lib_filetrans(init_t, agent_var_lib_t, dir, "agents")
allow init_t agent_var_lib_t:dir { relabelfrom relabelto };
list_dirs_pattern(init_t, agent_conf_t, agent_conf_t)
read_files_pattern(init_t, agent_conf_t, agent_conf_t)

# The agents' unit hides the gateway's control socket and the other
# agents' sockets (InaccessiblePaths=, TemporaryFileSystem=): systemd
# mounts over them in the agent's namespace.
gen_require(`
	type mcpgw_ctl_sock_t;
')
allow init_t mcpgw_ctl_sock_t:sock_file { getattr mounton };
allow init_t agent_runtime_t:dir mounton;

# The agents' unit has NoNewPrivileges=yes: without nnp_transition the
# kernel refuses systemd's transition to agent_t, and the launcher would
# run in init_t (as the first VM run showed).
gen_require(`
	class process2 { nnp_transition nosuid_transition };
')
allow init_t agent_t:process2 { nnp_transition nosuid_transition };
# The relay's unit has NoNewPrivileges=yes too.
allow init_t agent_relay_t:process2 { nnp_transition nosuid_transition };
