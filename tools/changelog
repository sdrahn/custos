#!/bin/sh
# changelog: the changes since the last release, one file per pull
# request in changes.d/ (changes.d/README.md), so that two pull requests
# never write into the same lines of CHANGELOG.md.
#
#   tools/changelog check             every file in changes.d is a fragment
#   tools/changelog show              the next release's section, as it stands
#   tools/changelog release vX.Y.Z [YYYY-MM-DD]
#                                     write the section "## vX.Y.Z — <date>"
#                                     into CHANGELOG.md, above the last
#                                     release's, and remove the fragments
#
# A fragment is changes.d/<topic>.<kind>.md, <kind> one of added,
# changed, fixed, removed, security: list items as they will stand in
# CHANGELOG.md ("- " and, for further lines, two spaces).
# changes.d/intro.md, if there, is the release's introduction (what it
# is about, what to know when upgrading), as it will stand.
#
# Run it from anywhere in the repository. The exit status is 1 if a
# check fails.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
dir=$root/changes.d
log=$root/CHANGELOG.md
kinds="added changed fixed removed security"

heading() {
	case "$1" in
	added) echo Added ;;
	changed) echo Changed ;;
	fixed) echo Fixed ;;
	removed) echo Removed ;;
	security) echo Security ;;
	esac
}

# fragments KIND: the kind's files, in the order of their names.
fragments() {
	find "$dir" -maxdepth 1 -type f -name "*.$1.md" 2>/dev/null | LC_ALL=C sort
}

check() {
	failed=0
	[ -d "$dir" ] || return 0
	for f in "$dir"/* "$dir"/.[!.]*; do
		[ -e "$f" ] || continue
		name=${f##*/}
		case "$name" in
		README.md) continue ;;
		intro.md)
			if grep -q '^##* ' "$f"; then
				echo "changelog: changes.d/intro.md has a heading; the release's is written for it" >&2
				failed=1
			fi
			continue
			;;
		esac
		if [ ! -f "$f" ] || ! echo "$name" | grep -Eq '^[a-z0-9][a-z0-9-]*\.(added|changed|fixed|removed|security)\.md$'; then
			echo "changelog: changes.d/$name is not <topic>.<kind>.md (lower case, digits and -; kind: $kinds)" >&2
			failed=1
			continue
		fi
		if [ "$(head -c 2 "$f")" != "- " ]; then
			echo "changelog: changes.d/$name does not start with a list item (\"- \")" >&2
			failed=1
		fi
		if [ -n "$(tail -c 1 "$f")" ]; then
			echo "changelog: changes.d/$name does not end with a newline" >&2
			failed=1
		fi
		if bad=$(grep -n -Ev '^(- |  |$)' "$f"); then
			echo "changelog: changes.d/$name: a line is neither a list item (\"- \") nor its continuation (two spaces):" >&2
			echo "$bad" | sed 's/^/  /' >&2
			failed=1
		fi
		if tail -n 1 "$f" | grep -q '^$'; then
			echo "changelog: changes.d/$name ends with an empty line" >&2
			failed=1
		fi
	done
	return "$failed"
}

# body: the section without its heading; nothing if there is no fragment.
body() {
	if [ -f "$dir/intro.md" ]; then
		cat "$dir/intro.md"
		echo
	fi
	for k in $kinds; do
		files=$(fragments "$k")
		[ -n "$files" ] || continue
		echo "### $(heading "$k")"
		echo
		echo "$files" | while IFS= read -r f; do cat "$f"; done
		echo
	done
}

cmd=${1:-}
case "$cmd" in
check)
	check
	;;
show)
	check
	body
	;;
release)
	tag=${2:?usage: changelog release vX.Y.Z [YYYY-MM-DD]}
	date=${3:-$(date -u +%Y-%m-%d)}
	case "$tag" in
	v[0-9]*.[0-9]*.[0-9]*) ;;
	*) echo "changelog: $tag is not a tag vX.Y.Z" >&2; exit 2 ;;
	esac
	echo "$date" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || { echo "changelog: $date is not a date YYYY-MM-DD" >&2; exit 2; }
	check
	if grep -q "^## $tag " "$log"; then
		echo "changelog: CHANGELOG.md already has a section for $tag" >&2
		exit 1
	fi
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	body >"$tmp/body"
	if [ ! -s "$tmp/body" ]; then
		echo "changelog: changes.d holds no change to release" >&2
		exit 1
	fi
	{
		echo "## $tag — $date"
		echo
		cat "$tmp/body"
	} >"$tmp/section"
	# Above the first released section; at the end of a changelog that
	# has none yet.
	awk -v section="$tmp/section" '
		!done && /^## / { while ((getline l < section) > 0) print l; done = 1 }
		{ print }
		END { if (!done) { print ""; while ((getline l < section) > 0) print l } }' "$log" >"$tmp/log"
	cat "$tmp/log" >"$log"
	for k in $kinds; do
		fragments "$k" | while IFS= read -r f; do rm -f "$f"; done
	done
	rm -f "$dir/intro.md"
	echo "changelog: CHANGELOG.md has the section for $tag; the fragments are removed"
	;;
*)
	sed -n '2,/^set -eu/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac
